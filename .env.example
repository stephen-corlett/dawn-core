# Copy this file to `.env`, which Git ignores. Never commit real secrets.

# development or production. Unset means production.
DAWN_ENV=development

# 64 hex characters. Required in production, and optional in development.
# Generate one with: openssl rand -hex 32
# DAWN_PRIVATE_KEY=

# Server address to listen on. Defaults to port 5000.
# DAWN_BIND_ADDR=0.0.0.0:5000

# Client address to connect to. Defaults to this machine.
# DAWN_SERVER_ADDR=127.0.0.1:5000
