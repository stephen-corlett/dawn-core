// Movement tuning for `just sandbox movement`. Save this file while the sandbox runs
// to apply it. The ground keeps its size until the sandbox restarts.
(
    sneak_speed: 1.5,
    run_speed: 5.4,
    sprint_speed: 8.2,
    dodge_speed: 7.2,
    dodge_secs: 0.7,
    dodge_cooldown_secs: 0.4,
    jump_speed: 7.0,
    gravity: 18.0,
    ground_snap: 0.4,
    body_radius: 0.4,
    world_half_extent: 10.0,
)
