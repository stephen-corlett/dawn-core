    sneak_speed: 1.5,
    run_speed: 5.4,
    sprint_speed: 8.2,
    dodge_lunge_speed: 9.0,
    dodge_lunge_secs: 0.4,
    dodge_rollout_speed: 2.2,
    dodge_rollout_secs: 0.6,
    dodge_recovery_secs: 0.25,
    dodge_recovery_speed: 1.5,
    jump_speed: 7.0,
    gravity: 18.0,
    ground_snap: 0.4,
    body_radius: 0.4,
    world_half_extent: 10.0,
)
